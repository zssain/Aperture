# Copy to .env for local development and fill in real values. NEVER commit .env.
# This file (.env.example) IS committed — it must contain ONLY placeholders,
# never real secrets. The backend fails loudly at startup on any missing required var.

# --- Backend: database (required) ---
# Two supported targets; pick ONE for DATABASE_URL. Always use the async driver
# scheme "postgresql+asyncpg://" (change Supabase's "postgresql://" to it).
#
# (a) LOCAL docker-compose Postgres (default dev target):
DATABASE_URL=postgresql+asyncpg://aperture:aperture@localhost:5432/aperture
#
# (b) SUPABASE-hosted Postgres. From Project Settings -> Database:
#   - App processes (API + worker): use the SESSION-mode POOLER string (port 5432
#     via the ...pooler.supabase.com host). Session mode keeps the SKIP-LOCKED job
#     claim and the audit-chain row lock behaving correctly.
#       DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#   - If you must use the TRANSACTION pooler (port 6543), you MUST also set
#     DB_STATEMENT_CACHE_SIZE=0 below (asyncpg prepared statements break otherwise).
#   - Alembic migrations: do NOT run through a pooler. Use the DIRECT connection via
#     the -x override (see docs/DEMO_RUNBOOK.md and docs/adr/0001-*.md):
#       alembic -x db_url=postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres upgrade head
#
# Connection-pool sizing (per process). Keep (pool_size + max_overflow) x processes
# under the host's connection cap (Supabase direct is small; the pooler is larger).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Set to 0 for ANY pooled connection (required for the Supabase transaction pooler,
# 6543). Leave commented for a direct or local connection.
# DB_STATEMENT_CACHE_SIZE=0

FRONTEND_ORIGIN=http://localhost:5173
REDECISION_DEBOUNCE_SECONDS=5
DECISION_CHANGE_WINDOW_DAYS=30
# Never enable in production; exposes the explicitly named demo event generator route.
DEMO_EVENTS_ENABLED=false

# --- Backend (optional, shown with defaults) ---
LOG_LEVEL=INFO
ENVIRONMENT=development
EMBEDDING_PROVIDER=noop
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
VECTOR_SIMILARITY_FLOOR=0.82
ALLOW_EXTERNAL_EMBEDDINGS=false
LLM_PROVIDER=noop
LLM_NOTICES_ENABLED=false
LLM_NOTICE_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=1200
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
SECRET_PROVIDER=environment
# Required only when SECRET_PROVIDER=aws_secrets_manager. Never put the value here.
AWS_SECRET_ID=
KMS_KEY_ARN=
DEMO_SEED_ENABLED=false

# --- Local Postgres via docker-compose (optional; unused when DATABASE_URL points at Supabase) ---
POSTGRES_USER=aperture
POSTGRES_PASSWORD=aperture
POSTGRES_DB=aperture
