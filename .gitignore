# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
*.egg-info/

# Node
node_modules/
# Anchored to the frontend: an unanchored `dist/` / `coverage/` also matched
# backend/app/services/coverage/ and silently dropped a real source package.
/frontend/dist/
/frontend/coverage/
.coverage
.coverage.*
playwright-report/
test-results/

# Env & secrets — never commit real env files
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
